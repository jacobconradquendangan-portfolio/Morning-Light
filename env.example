# ============================================================================
# Food Database API Keys
# Copy this file to `.env.local` and fill in your keys.
#   cp env.example .env.local
# ============================================================================

# ----------------------------------------------------------------------------
# USDA FoodData Central  (FREE - 1,000 requests/day)
# Get a key: https://fdc.nal.usda.gov/api-key-signup.html
# Authoritative generic foods: chicken breast, rice, apples, etc.
# ----------------------------------------------------------------------------
USDA_API_KEY=

# ----------------------------------------------------------------------------
# CalorieNinjas  (FREE - 10,000 requests/month)
# Register: https://calorieninjas.com/api
# Powers the "Describe" tab: natural language meal entry
#   "2 eggs and 1 cup rice" -> two items with macros
# OPTIONAL: without it, the Describe tab is hidden. Search and barcode are
# unaffected.
# ----------------------------------------------------------------------------
CALORIENINJAS_API_KEY=

# ----------------------------------------------------------------------------
# OpenFoodFacts  (FREE - no key required)
# Barcode fallback with 3M+ products. Set a polite User-Agent.
# Format: AppName/Version (contact-email)
# ----------------------------------------------------------------------------
OPENFOODFACTS_USER_AGENT=CalorieCounter/1.0 (you@example.com)
